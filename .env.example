# Frontend public (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only (Vercel) - NEVER prefix these with VITE_
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Drica Doces <pedidos@seudominio.com>
ORDER_NOTIFICATION_EMAIL=SEU-EMAIL@exemplo.com
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PUBLIC_SITE_URL=https://seusite.com.br
# Optional automatic WhatsApp approved template (Meta Cloud API)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TEMPLATE_NAME=drica_atualizacao_pedido
META_WHATSAPP_TEMPLATE_LANG=pt_BR
META_WHATSAPP_API_VERSION=v24.0
# Strongly advised: Turnstile captcha + Upstash Redis rate limiting
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LOYALTY_PEPPER=

# Fases 2/3: a capacidade diária e o percentual do sinal são configurados no painel.
# Notificações automáticas somente com Resend e Meta Business API corretamente habilitados.

# Assistente de encomendas (IA) — somente no servidor da Vercel. Sem chave, o site mostra o botão do WhatsApp.
# Gratuito: GROQ_API_KEY (console.groq.com). Alternativa paga: ANTHROPIC_API_KEY. Se houver as duas, usa o Groq.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Opcional: mensagens por dia (padrão 100 no Groq, 300 na Anthropic) e modelo (padrão openai/gpt-oss-120b ou claude-haiku-5-5)
AI_DAILY_LIMIT=
AI_MODEL=
